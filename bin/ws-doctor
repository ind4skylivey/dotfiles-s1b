#!/usr/bin/env bash

################################################################################
# ws-doctor: Comprehensive Eco-Workflow verification and diagnostics
#
# Purpose:
#   Run end-to-end health checks on the Livey Sib Gr0up Eco-Workflow system.
#   Verify entrypoints, environment propagation, logging, and tool reactions.
#
# Usage:
#   ws-doctor                    Run all checks
#   ws-doctor --verbose          Include detailed output
#   ws-doctor --test-session     Create test sessions (requires zellij/tmux)
#   ws-doctor --cleanup          Remove test artifacts
#
# Exit codes:
#   0 = All checks passed
#   1 = One or more checks failed
#   2 = Setup error (missing tools)
#
################################################################################

set -uo pipefail  # Don't exit on error; we handle it explicitly

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Counters
PASSED=0
FAILED=0
WARNINGS=0
VERBOSE=0
TEST_SESSION=0
CLEANUP=0

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
LOGS_DIR="${HOME}/.local/share/livey/logs"

# Helpers
print_check() {
    local status="$1"
    local msg="$2"
    case "$status" in
        PASS)
            echo -e "${GREEN}✓${NC} $msg"
            ((PASSED++))
            ;;
        FAIL)
            echo -e "${RED}✗${NC} $msg"
            ((FAILED++))
            ;;
        WARN)
            echo -e "${YELLOW}⚠${NC} $msg"
            ((WARNINGS++))
            ;;
        INFO)
            echo -e "${BLUE}ℹ${NC} $msg"
            ;;
    esac
}

print_section() {
    echo ""
    echo -e "${BLUE}=== $1 ===${NC}"
}

verbose() {
    if [[ $VERBOSE -eq 1 ]]; then
        echo "  $1"
    fi
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --verbose)
            VERBOSE=1
            shift
            ;;
        --test-session)
            TEST_SESSION=1
            shift
            ;;
        --cleanup)
            CLEANUP=1
            shift
            ;;
        *)
            echo "Unknown option: $1"
            exit 2
            ;;
    esac
done

################################################################################
# SECTION A: ENTRYPOINTS
################################################################################

print_section "A. Entrypoints"

check_entrypoint() {
    local script="$1"
    local full_path="${REPO_DIR}/bin/${script}"

    if [[ ! -f "$full_path" ]]; then
        print_check "FAIL" "$script: File not found at $full_path"
        return 1
    fi

    if [[ ! -x "$full_path" ]]; then
        print_check "FAIL" "$script: Not executable"
        return 1
    fi

    # Verify script runs with --help (ignore exit code as some scripts exit 1 on --help)
    if bash "$full_path" --help &>/dev/null || bash "$full_path" --help 2>&1 | grep -q "Usage:"; then
        print_check "PASS" "$script: Exists and executable"
        return 0
    else
        print_check "WARN" "$script: Exists but --help may not work"
        return 0
    fi
}

check_entrypoint "ws-local"
check_entrypoint "ws-remote"
check_entrypoint "ws-write"
check_entrypoint "ws-redteam"

# Check PATH
if echo "$PATH" | grep -q "dotfiles/bin"; then
    print_check "PASS" "dotfiles/bin is in PATH"
else
    print_check "FAIL" "dotfiles/bin NOT in PATH - scripts not callable by name"
    verbose "Add to PATH: export PATH=\"\$PATH:$REPO_DIR/bin\""
fi

################################################################################
# SECTION B: ZELLIJ LAYOUTS
################################################################################

print_section "B. Zellij Layouts"

check_layout() {
    local layout="$1"
    local layout_path="${REPO_DIR}/workflow/zellij/layouts/${layout}.kdl"

    if [[ ! -f "$layout_path" ]]; then
        print_check "FAIL" "Layout $layout not found"
        return 1
    fi

    # Basic KDL syntax check
    if grep -q "^layout" "$layout_path"; then
        print_check "PASS" "Layout $layout exists and has layout definition"
        verbose "Path: $layout_path"
        return 0
    else
        print_check "WARN" "Layout $layout exists but may be incomplete"
        return 0
    fi
}

check_layout "dev"
check_layout "write"
check_layout "monitor"
check_layout "fullscreen"

################################################################################
# SECTION C: LOGGING
################################################################################

print_section "C. Session Logging"

if [[ ! -d "$LOGS_DIR" ]]; then
    print_check "WARN" "Logs directory doesn't exist: $LOGS_DIR"
else
    print_check "PASS" "Logs directory exists: $LOGS_DIR"

    if [[ -f "${LOGS_DIR}/sessions.log" ]]; then
        log_entries=$(wc -l < "${LOGS_DIR}/sessions.log")
        print_check "PASS" "sessions.log exists with $log_entries entries"
        verbose "Recent entries:"
        tail -3 "${LOGS_DIR}/sessions.log" | while read line; do
            verbose "  $line"
        done
    else
        print_check "WARN" "sessions.log not yet created (will be created on first session)"
    fi
fi

################################################################################
# SECTION D: ENVIRONMENT PROPAGATION CODE
################################################################################

print_section "D. Environment Propagation Code"

# Check ws-local exports
if grep -q 'export LIVEY_WORKFLOW="local"' "${REPO_DIR}/bin/ws-local"; then
    print_check "PASS" "ws-local exports LIVEY_WORKFLOW"
    verbose "  Also exports: LIVEY_CONTEXT, LIVEY_WORKFLOW_LAYOUT, LIVEY_WORKFLOW_SESSION"
else
    print_check "FAIL" "ws-local doesn't export LIVEY_WORKFLOW"
fi

# Check ws-remote exports
if grep -q 'export LIVEY_WORKFLOW="remote"' "${REPO_DIR}/bin/ws-remote"; then
    print_check "PASS" "ws-remote exports LIVEY_WORKFLOW"
else
    print_check "FAIL" "ws-remote doesn't export LIVEY_WORKFLOW"
fi

# Check ws-write exports
if grep -q 'export LIVEY_WORKFLOW="write"' "${REPO_DIR}/bin/ws-write"; then
    print_check "PASS" "ws-write exports LIVEY_WORKFLOW"
else
    print_check "FAIL" "ws-write doesn't export LIVEY_WORKFLOW"
fi

# Check ws-redteam exports
if grep -q 'export LIVEY_WORKFLOW="redteam"' "${REPO_DIR}/bin/ws-redteam"; then
    print_check "PASS" "ws-redteam exports LIVEY_WORKFLOW"
else
    print_check "FAIL" "ws-redteam doesn't export LIVEY_WORKFLOW"
fi

# Check Tmux environment propagation
if grep -q 'tmux set-environment.*LIVEY_WORKFLOW' "${REPO_DIR}/bin/ws-remote"; then
    print_check "PASS" "ws-remote propagates LIVEY_WORKFLOW into tmux"
    verbose "  Uses: tmux set-environment"
else
    print_check "FAIL" "ws-remote doesn't propagate environment to tmux"
fi

################################################################################
# SECTION E: TOOL CONTEXT AWARENESS CODE
################################################################################

print_section "E. Tool Context Awareness Code"

# Neovim
if grep -q "LIVEY_WORKFLOW" "${HOME}/.config/nvim/init.lua" 2>/dev/null; then
    print_check "PASS" "Neovim reads LIVEY_WORKFLOW"
    if grep -q "linebreak" "${HOME}/.config/nvim/init.lua"; then
        print_check "PASS" "Neovim write profile enables linebreak/wrap"
    fi
else
    print_check "FAIL" "Neovim doesn't read LIVEY_WORKFLOW"
fi

# Doom Emacs
if grep -q "LIVEY_WORKFLOW" "${HOME}/.doom.d/config.el" 2>/dev/null; then
    print_check "PASS" "Doom Emacs reads LIVEY_WORKFLOW"
    if grep -q "visual-line-mode" "${HOME}/.doom.d/config.el"; then
        print_check "PASS" "Doom Emacs write profile enables visual-line-mode"
    fi
else
    print_check "FAIL" "Doom Emacs doesn't read LIVEY_WORKFLOW"
fi

# Helix (not expected to have context awareness)
if [[ -f "${HOME}/.config/helix/config.toml" ]]; then
    print_check "PASS" "Helix config exists (context awareness not expected)"
else
    print_check "WARN" "Helix config not found at ~/.config/helix/config.toml"
fi

# Fish prompt badge
if grep -q "__livey_prompt_badge" "${HOME}/.config/fish/config.fish" 2>/dev/null; then
    print_check "PASS" "Fish shell has __livey_prompt_badge function"
else
    print_check "WARN" "Fish prompt badge not configured"
fi

################################################################################
# SECTION F: INSTALLED TOOLS
################################################################################

print_section "F. Required Tools"

check_tool() {
    local tool="$1"
    local cmd="${2:-$tool}"

    if command -v "$cmd" &>/dev/null; then
        local version=$($cmd --version 2>&1 | head -1)
        print_check "PASS" "$tool: $(which $cmd) - $version"
        return 0
    else
        print_check "WARN" "$tool: Not found (may be optional)"
        return 1
    fi
}

check_tool "zellij"
check_tool "tmux"
check_tool "neovim" "nvim"
check_tool "emacs"
check_tool "helix" "hx"
check_tool "fish" "fish"

################################################################################
# SECTION G: TEST SESSION (Optional)
################################################################################

if [[ $TEST_SESSION -eq 1 ]]; then
    print_section "G. Test Session Creation"

    if ! command -v zellij &>/dev/null; then
        print_check "WARN" "Zellij not available, skipping local test session"
    else
        print_check "INFO" "Creating test Zellij session..."

        # Create a test session
        TEST_SESSION_NAME="ws-doctor-test-$$"
        LIVEY_WORKFLOW="local" LIVEY_CONTEXT="test" zellij -s "$TEST_SESSION_NAME" -n "${REPO_DIR}/workflow/zellij/layouts/dev.kdl" -- bash -c '
            echo "Test pane in Zellij"
            if [[ -n "${LIVEY_WORKFLOW:-}" ]]; then
                echo "✓ LIVEY_WORKFLOW=$LIVEY_WORKFLOW is set"
            else
                echo "✗ LIVEY_WORKFLOW is NOT set"
            fi
            sleep 1
        ' 2>/dev/null || true

        sleep 2

        # Check if session was created
        if zellij list-sessions 2>/dev/null | grep -q "$TEST_SESSION_NAME"; then
            print_check "PASS" "Test Zellij session created: $TEST_SESSION_NAME"
            verbose "  Attempting to kill test session..."
            zellij delete-session "$TEST_SESSION_NAME" 2>/dev/null || true
        else
            print_check "WARN" "Test Zellij session may not have persisted"
        fi
    fi
fi

################################################################################
# SECTION H: VERIFICATION SUMMARY
################################################################################

print_section "H. Verification Summary"

TOTAL=$((PASSED + FAILED + WARNINGS))
echo ""
echo -e "Results: ${GREEN}$PASSED passed${NC}, ${RED}$FAILED failed${NC}, ${YELLOW}$WARNINGS warnings${NC} (Total: $TOTAL checks)"
echo ""

if [[ $FAILED -gt 0 ]]; then
    echo -e "${RED}Status: NEEDS ATTENTION${NC}"
    echo ""
    echo "Issues found:"
    echo "1. dotfiles/bin not in PATH - scripts not callable by name"
    echo "   Fix: Add to ~/.config/fish/config.fish or shell rc:"
    echo "        set -gx PATH \$PATH $REPO_DIR/bin  # (Fish)"
    echo "        export PATH=\"\$PATH:$REPO_DIR/bin\"  # (Bash/Zsh)"
    echo ""
    exit 1
elif [[ $WARNINGS -gt 0 ]]; then
    echo -e "${YELLOW}Status: OK with warnings${NC}"
    echo "Everything works, but some features may not be optimal."
    exit 0
else
    echo -e "${GREEN}Status: ECO-WORKFLOW OK${NC}"
    echo "All checks passed! System is ready for use."
    exit 0
fi
