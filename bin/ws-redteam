#!/usr/bin/env bash

################################################################################
# ws-redteam: Bootstrap a minimalist tmux session for security work
#
# Usage:
#   ws-redteam [SESSION_NAME]
#
# This script:
#   1. Creates a distraction-free tmux session
#   2. Optimizes for deep focus on security tasks
#   3. Minimal chrome: no tabs, status bar info only
#   4. Respects existing tmux.conf
#   5. Ideal for penetration testing, CTF, exploit development
#
# Philosophy:
#   - Minimal visual overhead (maximize focus)
#   - Persistent session (survives disconnection)
#   - Simple but capable (no bloat)
#   - Terminal-first, keyboard-driven
#   - Ethical use only (authorized testing only)
################################################################################

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Defaults
SESSION_NAME=""

# Parse arguments
usage() {
    cat << EOF
Usage: ws-redteam [SESSION_NAME]

Bootstrap a minimalist tmux session for security work.

Arguments:
  SESSION_NAME    Custom session name (optional)

Features:
  • Distraction-free fullscreen focus
  • Persistent session (survives disconnection)
  • Minimal status bar (time, IP, critical info only)
  • Quick window switching
  • Logging and session capture

Examples:
  ws-redteam
  ws-redteam acme-pentest
  ws-redteam htb-challenge-1

Keybindings:
  Ctrl+A c       New window
  Ctrl+A n/p     Next/previous window
  Ctrl+A d       Detach session
  Ctrl+A z       Maximize/restore pane
  Ctrl+A [       Scroll history
  Ctrl+A :       Command mode

Ethical Usage:
  ✅ Authorized penetration testing
  ✅ CTF competitions and training labs
  ✅ Personal security research
  ✅ Defensive security work
  ✅ Threat analysis on owned systems

  ❌ Unauthorized access or hacking
  ❌ Malware development for attacks
  ❌ Denial of Service (DoS) attacks
  ❌ Supply chain compromise
  ❌ Illegal intrusion activities

ALWAYS ensure you have proper authorization before testing.

EOF
    exit 1
}

# Parse arguments
if [[ $# -gt 0 ]]; then
    case "$1" in
        --help|-h)
            usage
            ;;
        *)
            SESSION_NAME="$1"
            ;;
    esac
fi

# Check tmux
if ! command -v tmux &> /dev/null; then
    echo -e "${RED}Error: tmux not found.${NC}" >&2
    echo "Install with: pacman -S tmux"
    exit 1
fi

# Generate semantic session name if not provided
if [[ -z "$SESSION_NAME" ]]; then
    # Format: redteam-target or just redteam for generic sessions
    SESSION_NAME="redteam-$(date +%s | tail -c 4)"
fi

# Ensure semantic naming
if [[ ! "$SESSION_NAME" =~ ^redteam ]]; then
    SESSION_NAME="redteam-${SESSION_NAME}"
fi

# Determine context (session name or "general")
CONTEXT="${SESSION_NAME#redteam-}"

# Export workflow state
export LIVEY_WORKFLOW="redteam"
export LIVEY_CONTEXT="$CONTEXT"
export LIVEY_WORKFLOW_SESSION="$SESSION_NAME"

# Log session start
LOG_DIR="${HOME}/.local/share/livey/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="${LOG_DIR}/sessions.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] START redteam | context=$CONTEXT | session=$SESSION_NAME" >> "$LOG_FILE"

echo -e "${BLUE}Security Workflow Session${NC}"
echo -e "${YELLOW}⚠️  Ethical use only - authorized testing only${NC}"
echo -e "${BLUE}Profile: ${GREEN}redteam${BLUE} | Context: ${GREEN}$CONTEXT${BLUE} | Session: ${GREEN}${SESSION_NAME}${NC}"
echo -e "${BLUE}Export: LIVEY_WORKFLOW=$LIVEY_WORKFLOW LIVEY_CONTEXT=$LIVEY_CONTEXT${NC}"
echo ""

# Check if session exists
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo -e "${GREEN}Attaching to existing session...${NC}"
    tmux attach-session -t "$SESSION_NAME"
else
    # Create new minimalist session
    echo -e "${GREEN}Creating new session...${NC}"

    # Create session
    tmux new-session -d -s "$SESSION_NAME" -x 200 -y 50

    # Set session options
    # Minimize chrome: no status bar unless needed
    tmux set-option -t "$SESSION_NAME" status on
    tmux set-option -t "$SESSION_NAME" status-position top

    # Minimal status bar format
    # Shows: session name | window list | time
    tmux set-option -t "$SESSION_NAME" status-format[0] \
        " #{session_name} | Windows: #{session_windows} | #{t/f:%H:%M:%S}"

    # Start shell in main pane
    tmux send-keys -t "$SESSION_NAME" "export HISTFILE=~/.bash_history_redteam" Enter
    tmux send-keys -t "$SESSION_NAME" "clear" Enter

    # Print welcome message
    tmux send-keys -t "$SESSION_NAME" "printf '%s\\n' '🎯 Red-Team Session: $SESSION_NAME' 'Use Ctrl+A ? for tmux help' ''" Enter

    # Attach to session
    echo -e "${GREEN}Attaching to session...${NC}"
    echo ""
    echo -e "${BLUE}Quick Commands:${NC}"
    echo "  Ctrl+A c       → New window"
    echo "  Ctrl+A n/p     → Next/previous window"
    echo "  Ctrl+A d       → Detach session"
    echo "  Ctrl+A z       → Maximize pane"
    echo "  Ctrl+A :       → Command mode"
    echo "  Ctrl+A ?       → Full keybindings"
    echo ""
    echo -e "${YELLOW}Remember: Only test systems you own or have explicit authorization.${NC}"
    echo ""

    tmux attach-session -t "$SESSION_NAME"
fi

echo -e "${GREEN}Session ended.${NC}"
