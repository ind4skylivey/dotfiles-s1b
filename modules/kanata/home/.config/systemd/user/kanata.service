# Requires access to /dev/uinput and the keyboard device:
#   sudo usermod -aG input $USER
#   udev rule: KERNEL=="uinput", GROUP="input", MODE="0660"
[Unit]
Description=kanata remapeo teclado RK R75

[Service]
ExecStart=/usr/bin/kanata --cfg %h/.config/kanata/kanata.kbd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
