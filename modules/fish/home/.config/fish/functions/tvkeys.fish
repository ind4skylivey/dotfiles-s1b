function tvkeys --description 'Atajos niri para OmarchyTV'
    echo "OmarchyTV (Mod+Alt + ...)"
    echo "  P  play/pausa"
    echo "  K  volumen +   (vim arriba)"
    echo "  J  volumen -   (vim abajo)"
    echo "  M  mute"
    echo "  H  home TV"
    echo "  Y  YouTube"
    echo "  F  Spotify"
end
