-- treesitter-fix
-- Patches nvim-treesitter query_predicates for Neovim 0.12+ compatibility
--
-- Bug: In Neovim 0.12+, match[id] returns a LIST instead of a single node.
-- This causes "attempt to call method 'range' (a nil value)" errors when
-- opening markdown files with fenced code blocks.
--
-- Fix: Patch vim.treesitter.get_range to handle nil nodes gracefully and
-- provide a get_node helper for future-proofing predicates.
--
-- Since nvim-treesitter was archived on April 3, 2026, this plugin provides
-- the necessary monkey-patch without requiring manual edits to lazy plugins.

return {
  name = "treesitter-fix",
  dir = "~/.config/nvim/lua/plugins/treesitter-fix",
  lazy = false,
  priority = 1001,

  config = function()
    -- Helper to unwrap match captures (Neovim 0.12+ returns lists)
    local function get_node(match, id)
      local val = match[id]
      if not val then
        return nil
      end
      if type(val) == "table" and #val > 0 then
        return val[1]
      end
      return val
    end

    -- Force load nvim-treesitter.query_predicates
    package.loaded["nvim-treesitter.query_predicates"] = nil
    require("nvim-treesitter.query_predicates")

    -- Patch the module with our get_node helper
    local predicates = require("nvim-treesitter.query_predicates")
    if not predicates.get_node then
      predicates.get_node = get_node
    end

    -- Patch vim.treesitter.get_range to handle nil nodes gracefully
    local ts = require("vim.treesitter")
    local orig_get_range = ts.get_range

    ts.get_range = function(node, metadata, ...)
      if node == nil then
        return nil
      end
      if type(node) == "table" and #node > 0 then
        node = node[1]
      end
      if node == nil then
        return nil
      end
      return orig_get_range(node, metadata, ...)
    end

    -- Also patch get_node_text to be nil-safe
    local orig_get_node_text = ts.get_node_text
    ts.get_node_text = function(node, ...)
      if node == nil then
        return nil
      end
      if type(node) == "table" and #node > 0 then
        node = node[1]
      end
      if node == nil then
        return nil
      end
      return orig_get_node_text(node, ...)
    end

    -- Mark as patched
    if not predicates._patched then
      predicates._patched = true
    end
  end,
}
