{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
     "logo": {
         "source": "~/.config/fastfetch/il1v3y_logo.txt",
         "type": "auto",
         "color": {
             "1": "#FF6B9D",
             "2": "#00D9FF",
             "3": "#A855F7",
             "4": "#FF0055",
             "5": "#00FF41",
             "6": "#5DADE2"
         }
     },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "host",
            "key": "╭─󰌢",
            "keyColor": "green"
        },
        {
            "type": "board",
            "key": "├─󰚐",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "├─󰻠",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "├─󰍛",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "├─󰑭",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "key": "├─󰍹",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "key": "├─󰍹",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "key": "╰─󰍹",
            "keyColor": "green"
        },
        "break",
        {
            "type": "title",
            "key": "╭─",
            "format": "{1}@{2}",
            "keyColor": "blue"
        },
        {
            "type": "os",
            "key": "├─󰣇", 
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "├─󰖲",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "├─󰆍",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "├─",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "├─󰏖",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "├─󰅐",
            "keyColor": "blue"
        },
        {
          "type": "battery",
          "key": "╰─󰁹",
          "keyColor": "blue"
        },
        "break",
        {
            "type": "disk",
            "key": "╭─󰋢",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "╰─󰋢",
            "keyColor": "yellow",
            "folders": "/home"
        },
        "break",
        {
            "type": "media",
            "key": "╰─󰝚",
            "keyColor": "magenta",
            "playerName": "auto"
        }
    ]
}
