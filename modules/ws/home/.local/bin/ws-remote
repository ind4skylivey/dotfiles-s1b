#!/usr/bin/env bash

################################################################################
# ws-remote: Bootstrap a persistent remote tmux session
#
# Usage:
#   ws-remote user@host [port]
#   ws-remote user@host --key ~/.ssh/id_ed25519 --port 2222
#
# This script:
#   1. Establishes SSH connection to remote
#   2. Creates or attaches to a persistent tmux session
#   3. Respects existing tmux.conf
#   4. Fails gracefully if tmux/ssh not available
#
# Philosophy:
#   - Minimal intervention in existing configs
#   - Safe to run multiple times
#   - Recoverable if session crashes
################################################################################

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Default values
PORT=22
SSH_KEY=""
REMOTE_HOST=""

# Parse arguments
usage() {
    cat << EOF
Usage: ws-remote user@host [port]
       ws-remote user@host --key ~/.ssh/id_ed25519 --port 2222

Bootstrap a persistent tmux session on a remote machine.

Arguments:
  user@host      SSH target (required)
  port           SSH port (default: 22)
  --key FILE     SSH private key
  --port PORT    SSH port number

Examples:
  ws-remote deploy@prod.example.com
  ws-remote admin@10.0.1.5 2222
  ws-remote dev@staging.internal --key ~/.ssh/dev_key

EOF
    exit 1
}

if [[ $# -eq 0 ]]; then
    usage
fi

REMOTE_HOST="$1"
shift

# Parse remaining arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --key)
            SSH_KEY="$2"
            shift 2
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        *)
            # Treat as port if it's a number
            if [[ "$1" =~ ^[0-9]+$ ]]; then
                PORT="$1"
                shift
            else
                echo -e "${RED}Error: Unknown argument: $1${NC}" >&2
                usage
            fi
            ;;
    esac
done

# Validation
if ! command -v ssh &> /dev/null; then
    echo -e "${RED}Error: ssh not found. Install OpenSSH.${NC}" >&2
    exit 1
fi

if ! command -v tmux &> /dev/null; then
    echo -e "${YELLOW}Warning: tmux not found on local machine.${NC}" >&2
    echo "Attempting SSH anyway. You may need to install tmux on the remote."
fi

# Extract hostname for semantic session naming
# Format: remote-hostname (extracted from user@hostname)
HOSTNAME=$(echo "$REMOTE_HOST" | cut -d'@' -f2 | cut -d'.' -f1)
SESSION_NAME="remote-${HOSTNAME}"

# Build SSH command
SSH_CMD="ssh"
if [[ -n "$SSH_KEY" ]]; then
    SSH_CMD="$SSH_CMD -i $SSH_KEY"
fi
SSH_CMD="$SSH_CMD -p $PORT $REMOTE_HOST"

# Export workflow state (on local side)
export LIVEY_WORKFLOW="remote"
export LIVEY_CONTEXT="$REMOTE_HOST"
export LIVEY_WORKFLOW_HOST="$REMOTE_HOST"
export LIVEY_WORKFLOW_SESSION="$SESSION_NAME"

# Log session start
LOG_DIR="${HOME}/.local/share/livey/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="${LOG_DIR}/sessions.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] START remote | context=$REMOTE_HOST | session=$SESSION_NAME" >> "$LOG_FILE"

# Connect and setup tmux session
echo -e "${GREEN}Connecting to $REMOTE_HOST:$PORT...${NC}"
echo -e "${BLUE}Profile: ${GREEN}remote${BLUE} | Context: ${GREEN}$REMOTE_HOST${BLUE} | Session: ${GREEN}${SESSION_NAME}${NC}"
echo -e "${BLUE}Export: LIVEY_WORKFLOW=$LIVEY_WORKFLOW LIVEY_CONTEXT=$LIVEY_CONTEXT${NC}"

# SSH and create/attach to tmux session
# If tmux session exists, attach to it
# If not, create a new one with a nice layout
$SSH_CMD bash << 'REMOTE_BASH'
if ! command -v tmux &> /dev/null; then
    echo "tmux not found on remote. Installing..."
    if command -v apt &> /dev/null; then
        sudo apt-get update && sudo apt-get install -y tmux
    elif command -v pacman &> /dev/null; then
        sudo pacman -Sy tmux
    elif command -v yum &> /dev/null; then
        sudo yum install -y tmux
    else
        echo "Cannot auto-install tmux. Please install manually."
        exit 1
    fi
fi

# Create session name from hostname
HOSTNAME=$(hostname | tr '.' '_')
SESSION_NAME="$HOSTNAME"

# Check if session exists
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    # Attach to existing session
    tmux attach-session -t "$SESSION_NAME"
else
    # Create new session with development layout
    # Main pane (left 70%): editor/work
    # Top-right pane: logs/monitoring
    # Bottom-right pane: interactive shell

    tmux new-session -d -s "$SESSION_NAME" -x 200 -y 50

    # Set environment variables for context awareness
    tmux set-environment -t "$SESSION_NAME" LIVEY_WORKFLOW "remote"
    tmux set-environment -t "$SESSION_NAME" LIVEY_CONTEXT "$(hostname)"

    # Create layout: one main pane, split the right side
    tmux send-keys -t "$SESSION_NAME" "cd ~; exec bash" Enter

    # Split right 30% for monitoring
    tmux split-window -t "$SESSION_NAME" -h -p 30

    # Split the right pane horizontally
    tmux split-window -t "$SESSION_NAME" -v -p 50

    # Layout arrangement: left is main, top-right is monitor, bottom-right is shell
    tmux select-window -t "$SESSION_NAME:0"
    tmux select-pane -t "$SESSION_NAME:0.0" # Focus main pane

    # Attach to the new session
    tmux attach-session -t "$SESSION_NAME"
fi
REMOTE_BASH

echo -e "${GREEN}Session ended.${NC}"
