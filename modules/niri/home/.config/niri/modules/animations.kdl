// ============================================================
// modules/animations.kdl
// Identical to animations-7.kdl from Noctara-Dots -- native niri
// curves, not dependent on Noctalia. Reused as-is.
// ============================================================

animations {
    workspace-switch {
        duration-ms 225
        curve "cubic-bezier" 0.2 0.0 0.0 1.0
    }

    window-open {
        duration-ms 300
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }

    window-close {
        duration-ms 200
        curve "cubic-bezier" 0.3 0.0 0.8 0.15
    }

    window-movement {
        duration-ms 250
        curve "cubic-bezier" 0.2 0.0 0.0 1.0
    }

    window-resize {
        duration-ms 250
        curve "cubic-bezier" 0.2 0.0 0.0 1.0
    }

    horizontal-view-movement {
        duration-ms 250
        curve "cubic-bezier" 0.2 0.0 0.0 1.0
    }

    overview-open-close {
        duration-ms 250
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }

    recent-windows-close {
        duration-ms 200
        curve "cubic-bezier" 0.3 0.0 0.8 0.15
    }

    screenshot-ui-open {
        duration-ms 200
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }

    slowdown 1.0
}
