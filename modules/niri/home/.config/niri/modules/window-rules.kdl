// ============================================================
// modules/window-rules.kdl
// Generic Noctara-Dots rules + translated from dwm Rule rules[].
// ============================================================

// --- Generics ---

window-rule {
    geometry-corner-radius 9
    clip-to-geometry true
    draw-border-with-background false
    opacity 0.975
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id=r#"firefox"# title="^Picture-in-Picture$"
    open-floating true
}

/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

// --- Noctalia: settings panel floating ---

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 850; }
    default-window-height { fixed 700; }
}

// --- Translated from dwm config.h Rule rules[] ---

window-rule {
    match app-id=r#"firefox$"#
    match app-id=r#"^Google-chrome$"#
    match app-id=r#"^Brave-browser$"#
    match app-id=r#"zen-alpha$"#
    match app-id=r#"^helium$"#
    open-on-workspace "web"
    background-effect {
        blur true
        xray true
    }
    open-maximized true
}

window-rule {
    match app-id=r#"^lutris$"#
    match app-id=r#"^steam_app_default$"#
    open-floating true
}

window-rule {
    match app-id=r#"^gamescope$"#
    open-fullscreen true
}

window-rule {
    match app-id=r#"^dolphin$"#
    match app-id=r#"^Pcmanfm-qt$"#
    match app-id=r#"^Thunar$"#
    open-on-workspace "docs"
    open-floating true
    default-column-width { fixed 900; }
}

window-rule {
    match app-id=r#"^retroarch$"#
    match app-id=r#"^es-de$"#
    open-floating true
}

window-rule {
    match app-id=r#"^vesktop$"#
    match app-id=r#"^discord$"#
    match app-id=r#"^Legcord$"#
    open-on-workspace "chill"
}



window-rule {
    match app-id=r#"^Pavucontrol$"#
    match app-id=r#"^Blueman-manager$"#
    match app-id=r#"^Nm-connection-editor$"#
    open-floating true
}

window-rule {
    match title=r#"^GtkFileChooserDialog$"#
    match title=r#"xdg-desktop-portal"#
    match title=r#"pop-up"#
    open-floating true
}

// --- Terminals: transparency + blur ---
window-rule {
    match app-id=r#"^Alacritty$"#
    match app-id=r#"^kitty$"#
    background-effect {
        blur true
        xray true
    }
    opacity 0.97
}

// --- Video players: floating ---
window-rule {
    match app-id=r#"^mpv$"#
    match app-id=r#"^vlc$"#
    open-floating true
}

// --- Spotify: media workspace ---
window-rule {
    match app-id=r#"^spotify$"#
    open-on-workspace "chill"
}

// --- Thunderbird: chat workspace ---
window-rule {
    match app-id=r#"^thunderbird$"#
    match app-id=r#"^org\.mozilla\.Thunderbird$"#
    open-on-workspace "chill"
}

// --- IDEs: default column layout ---
window-rule {
    match app-id=r#"^zed$"#
    match app-id=r#"^dev\.zed\.Zed$"#
    match app-id=r#"^helix$"#
    default-column-width {}
}

// --- Proton VPN: floating ---
window-rule {
    match app-id=r#"^proton\.vpn\.app\.gtk$"#
    open-floating true
}

// --- ArchyNotch: borderless + floating ---
window-rule {
    match app-id="archynotch"
    border {
        off
    }
    open-floating true
}
