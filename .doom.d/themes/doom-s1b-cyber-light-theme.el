;;; doom-s1b-cyber-light-theme.el --- Cyberpunk light theme with pastel purple -*- lexical-binding: t; no-byte-compile: t; -*-
;;
;; Light sibling of doom-outrun-electric: same accent roles (keywords magenta,
;; functions cyan, types/yellow, strings periwinkle, variables violet), every
;; accent >= 4.5:1 on both bg and bg-alt.
;; Light companion for doom-outrun-electric: pastel purple paper, ink-violet
;; text and neon accents darkened enough to stay readable on a light bg.
;;
;;; Code:

(require 'doom-themes)

(def-doom-theme doom-s1b-cyber-light
  "Cyberpunk light theme: pastel purple background, ink violet text, neon accents."
  :family 'doom-s1b-cyber
  :background-mode 'light

  ;; name        default   256       16
  ((bg         '("#d9c2f5" "#d9c2f5" "white"        ))
   (fg         '("#2a1b3d" "#2a1b3d" "black"        ))
   (bg-alt     '("#c9b0ec" "#c9b0ec" "white"        ))
   (fg-alt     '("#3a2ee6" "#3a2ee6" "brightblack"  ))

   (base0      '("#e6d6fa" "#e6d6fa" "white"        ))
   (base1      '("#cfb5f2" "#cfb5f2" "brightblack"  ))
   (base2      '("#c3a5ec" "#c3a5ec" "brightblack"  ))
   (base3      '("#b393e3" "#b393e3" "brightblack"  ))
   (base4      '("#8a6fb0" "#8a6fb0" "brightblack"  ))
   (base5      '("#504465" "#504465" "brightblack"  ))
   (base6      '("#4a3a63" "#4a3a63" "brightblack"  ))
   (base7      '("#35264b" "#35264b" "brightblack"  ))
   (base8      '("#1a0f28" "black"   "black"        ))

   (grey       '("#454764" "#454764" "gray"         ))
   (red        '("#ba001f" "#ba001f" "red"          ))
   (orange     '("#a33600" "#a33600" "brightred"    ))
   (green      '("#196600" "#196600" "green"        ))
   (teal       '("#6510f2" "#6510f2" "brightgreen"  ))
   (yellow     '("#7d5300" "#7d5300" "yellow"       ))
   (blue       '("#0054c9" "#0054c9" "brightblue"   ))
   (dark-blue  '("#0057ad" "#0057ad" "blue"         ))
   (magenta    '("#ab0078" "#ab0078" "magenta"      ))
   (violet     '("#8000db" "#8000db" "brightmagenta"))
   (pink       '("#b00049" "#b00049" "brightmagenta"))
   (cyan       '("#006478" "#006478" "brightcyan"   ))
   (dark-cyan  '("#005f69" "#005f69" "cyan"         ))

   ;; face categories
   (highlight      blue)
   (vertical-bar   base3)
   (selection      base2)
   (builtin        blue)
   (comments       grey)
   (doc-comments   teal)
   (constants      pink)
   (functions      cyan)
   (keywords       magenta)
   (methods        cyan)
   (operators      magenta)
   (type           yellow)
   (strings        fg-alt)
   (variables      violet)
   (numbers        orange)
   (region         '("#6a0dad" "#6600aa" "brightblack"))
   (error          red)
   (warning        orange)
   (success        green)
   (vc-modified    orange)
   (vc-added       green)
   (vc-deleted     red)

   (modeline-fg          fg)
   (modeline-fg-alt      base5)
   (modeline-bg          '("#b98cf5" "#ccaaee" "white"))
   (modeline-bg-alt      bg-alt)
   (modeline-bg-inactive bg-alt)
   (modeline-bg-inactive-alt bg-alt))

  ;;;; Base theme face overrides
  (((font-lock-keyword-face &override) :weight 'bold)
   ((font-lock-function-name-face &override) :weight 'bold)
   ((line-number &override) :foreground base4)
   ((line-number-current-line &override) :foreground magenta :weight 'bold)
   (cursor :background "#ff00c8")
   (hl-line :background "#c6a2fb" :extend t)
   (region :background region :foreground "#f5eaff" :extend t)
   (vertical-border :foreground base3)
   (mode-line :background modeline-bg :foreground modeline-fg
              :box `(:line-width 2 :color ,magenta) :underline `(:color "#ff00c8" :position t))
   (mode-line-active :background modeline-bg :foreground modeline-fg
                     :box `(:line-width 2 :color ,magenta) :underline `(:color "#ff00c8" :position t))
   (mode-line-inactive :background modeline-bg-inactive :foreground modeline-fg-alt
                       :box `(:line-width 1 :color ,base3))
   (mode-line-emphasis :foreground violet :weight 'bold)
   (tab-bar :background bg-alt :foreground fg)
   (tab-bar-tab :background bg :foreground violet :weight 'bold)
   (tab-bar-tab-inactive :background bg-alt :foreground base5)
   (minibuffer-prompt :foreground violet :weight 'bold)
   (show-paren-match :background base2 :foreground magenta :weight 'bold)
   (isearch :background magenta :foreground base0 :weight 'bold)
   (lazy-highlight :background base3 :foreground fg)
   ;;;; doom-modeline
   (doom-modeline-bar :background "#ff00c8")
   (doom-modeline-buffer-file :foreground fg :weight 'bold)
   (doom-modeline-buffer-modified :foreground magenta :weight 'bold)
   (doom-modeline-project-dir :foreground teal :weight 'bold)
   ;;;; org
   (org-level-1 :foreground violet :weight 'bold)
   (org-level-2 :foreground magenta :weight 'bold)
   (org-level-3 :foreground teal :weight 'bold)
   (org-level-4 :foreground orange :weight 'bold)
   (org-level-5 :foreground pink :weight 'bold)
   (org-level-6 :foreground dark-blue :weight 'bold)
   (org-block :background base0 :extend t)
   (org-block-begin-line :background bg-alt :foreground base5 :extend t)
   (org-code :foreground orange)
   (org-verbatim :foreground teal)
   (org-document-title :foreground violet :weight 'bold)
   ;;;; magit
   (magit-section-heading :foreground violet :weight 'bold)
   (magit-branch-local :foreground cyan :weight 'bold)
   (magit-branch-remote :foreground green)
   (magit-hash :foreground pink)
   (magit-diff-hunk-heading :background base2 :foreground fg)
   (magit-diff-hunk-heading-highlight :background base3 :foreground fg :weight 'bold)
   (magit-diff-context-highlight :background base1 :foreground fg)
   (magit-diff-added :background (doom-blend green bg 0.15) :foreground green)
   (magit-diff-added-highlight :background (doom-blend green bg 0.25) :foreground green :weight 'bold)
   (magit-diff-removed :background (doom-blend red bg 0.12) :foreground red)
   (magit-diff-removed-highlight :background (doom-blend red bg 0.22) :foreground red :weight 'bold)
   ;;;; lsp / flycheck
   (lsp-face-highlight-textual :background base2 :weight 'bold)
   (lsp-face-highlight-read :background base2 :weight 'bold)
   (lsp-face-highlight-write :background base3 :weight 'bold)
   (lsp-headerline-breadcrumb-symbols-face :foreground violet)
   (lsp-ui-doc-background :background base0)
   (lsp-ui-peek-highlight :background base3 :foreground fg)
   (flycheck-error :underline `(:style wave :color ,red))
   (flycheck-warning :underline `(:style wave :color ,orange))
   (flycheck-info :underline `(:style wave :color ,teal))
   ;;;; keyhelp context bar
   (+lv/ctxbar-desc-face :foreground base7 :weight 'semi-bold)
   ;;;; solaire: keep every buffer on the same purple bg (never white)
   (solaire-default-face :background bg)
   (solaire-fringe-face :background bg)
   (solaire-hl-line-face :background "#c6a2fb" :extend t)
   (solaire-org-hide-face :foreground bg)
   (solaire-line-number-face :foreground base4 :background bg)
   (fringe :background bg)
   ;;;; eshell
   (eshell-prompt :foreground magenta :weight 'bold)
   (+eshell-prompt-pwd :foreground blue :weight 'bold)
   (+eshell-prompt-git-branch :foreground green :weight 'bold)
   (eshell-ls-directory :foreground blue :weight 'bold)
   (eshell-ls-executable :foreground green :weight 'bold)
   (eshell-ls-symlink :foreground cyan :slant 'italic)
   (eshell-ls-archive :foreground orange :weight 'bold)
   (eshell-ls-backup :foreground grey)
   (eshell-ls-clutter :foreground grey :strike-through t)
   (eshell-ls-missing :foreground red :weight 'bold)
   (eshell-ls-product :foreground yellow)
   (eshell-ls-readonly :foreground pink)
   (eshell-ls-special :foreground violet :weight 'bold)
   (eshell-ls-unreadable :foreground red)
   (eshell-syntax-highlighting-shell-command-face :foreground green :weight 'bold)
   (eshell-syntax-highlighting-invalid-face :foreground red :weight 'bold)
   ;;;; ANSI (ansi-color, term, vterm)
   (ansi-color-black :foreground fg :background fg)
   (ansi-color-red :foreground red :background red)
   (ansi-color-green :foreground green :background green)
   (ansi-color-yellow :foreground yellow :background yellow)
   (ansi-color-blue :foreground blue :background blue)
   (ansi-color-magenta :foreground magenta :background magenta)
   (ansi-color-cyan :foreground cyan :background cyan)
   (ansi-color-white :foreground base5 :background base5)
   (ansi-color-bright-black :foreground grey :background grey)
   (ansi-color-bright-red :foreground "#e6003a" :background "#e6003a")
   (ansi-color-bright-green :foreground "#2f9a00" :background "#2f9a00")
   (ansi-color-bright-yellow :foreground "#b07800" :background "#b07800")
   (ansi-color-bright-blue :foreground "#1a6dff" :background "#1a6dff")
   (ansi-color-bright-magenta :foreground "#e000b0" :background "#e000b0")
   (ansi-color-bright-cyan :foreground "#008ba8" :background "#008ba8")
   (ansi-color-bright-white :foreground base7 :background base7)
   (term-color-black :inherit 'ansi-color-black)
   (term-color-red :inherit 'ansi-color-red)
   (term-color-green :inherit 'ansi-color-green)
   (term-color-yellow :inherit 'ansi-color-yellow)
   (term-color-blue :inherit 'ansi-color-blue)
   (term-color-magenta :inherit 'ansi-color-magenta)
   (term-color-cyan :inherit 'ansi-color-cyan)
   (term-color-white :inherit 'ansi-color-white)
   (term :foreground fg)
   (vterm-color-black :inherit 'ansi-color-black)
   (vterm-color-red :inherit 'ansi-color-red)
   (vterm-color-green :inherit 'ansi-color-green)
   (vterm-color-yellow :inherit 'ansi-color-yellow)
   (vterm-color-blue :inherit 'ansi-color-blue)
   (vterm-color-magenta :inherit 'ansi-color-magenta)
   (vterm-color-cyan :inherit 'ansi-color-cyan)
   (vterm-color-white :inherit 'ansi-color-white)
   ;;;; modeline extras
   (doom-modeline-buffer-major-mode :foreground violet :weight 'bold)
   (doom-modeline-buffer-path :foreground blue :weight 'bold)
   (doom-modeline-info :foreground green :weight 'bold)
   (doom-modeline-warning :foreground orange :weight 'bold)
   (doom-modeline-urgent :foreground red :weight 'bold)
   (doom-modeline-evil-normal-state :foreground blue :weight 'bold)
   (doom-modeline-evil-insert-state :foreground green :weight 'bold)
   (doom-modeline-evil-visual-state :foreground magenta :weight 'bold)
   (doom-modeline-lsp-success :foreground green)
   (doom-modeline-project-root-dir :foreground cyan :weight 'bold)
   ;;;; completion / which-key
   (vertico-current :background "#6a0dad" :foreground "#f5eaff" :weight 'bold :extend t)
   (orderless-match-face-0 :foreground magenta :weight 'bold)
   (orderless-match-face-1 :foreground blue :weight 'bold)
   (orderless-match-face-2 :foreground green :weight 'bold)
   (orderless-match-face-3 :foreground orange :weight 'bold)
   (marginalia-documentation :foreground fg-alt :slant 'italic)
   (marginalia-key :foreground magenta)
   (marginalia-file-priv-dir :foreground blue)
   (which-key-key-face :foreground magenta :weight 'bold)
   (which-key-command-description-face :foreground base7)
   (which-key-group-description-face :foreground blue :weight 'bold)
   (which-key-local-map-description-face :foreground cyan)
   (which-key-separator-face :foreground base4)
   ;;;; dired
   (dired-directory :foreground blue :weight 'bold)
   (dired-symlink :foreground cyan :slant 'italic)
   (diredfl-dir-name :foreground blue :weight 'bold)
   (diredfl-symlink :foreground cyan :slant 'italic)
   (diredfl-exec-priv :foreground green :weight 'bold)
   (diredfl-file-suffix :foreground orange)
   (diredfl-date-time :foreground fg-alt)
   (diredfl-number :foreground yellow)
   (dired-header :foreground magenta :weight 'bold)
   ;;;; magit extras
   (magit-section-highlight :background "#c6a2fb" :extend t)
   (magit-branch-current :foreground magenta :weight 'bold :box `(:line-width 1 :color ,magenta))
   (magit-head :foreground magenta :weight 'bold)
   (magit-log-author :foreground orange)
   (magit-log-date :foreground fg-alt)
   (magit-tag :foreground yellow :weight 'bold))

  ;;;; Base theme variable overrides
  ())

;;; doom-s1b-cyber-light-theme.el ends here
