# Sensitive data
*.log
*.secret
*.token
auth.json
**/github_token*
**/api_key*
*.pem
*.key

# Cache and temporary files
**/.cache/
**/cache/
**/__pycache__/
*.pyc
*.swp
*.swo
*~
.DS_Store

# Zsh cache files
**/.zcompdump*
**/.zsh_history
**/.histfile

# Fish cache
**/.config/fish/fish_variables
**/.config/fish/fishd.*

# Tmux plugins (will be installed by tpm)
**/.config/tmux/plugins/
**/tmux/plugins/

# Neovim/Vim cache and plugins
**/.config/nvim/plugin/
**/.config/nvim/.netrwhist
**/.config/nvim/undodir/

# Doom Emacs generated files
.doom.d/.local/

# Node modules (if any config uses npm)
**/node_modules/

# Compiled binaries
*.o
*.so
*.out
**/dwm/dwm
**/dwm/*.o
**/dwm/drw.o
**/dwm/util.o
**/dwm/slstatus/slstatus
**/dwm/slstatus/*.o
**/dwm/slstatus/components/*.o
**/dwm/release/dwm
**/dwm/*.backup-*
st

# Obsidian vault data (too large)
**/.config/obsidian/

# Game launchers and large apps
**/.config/heroic/
**/.config/legcord/

# IDE specific
**/.idea/
**/.vscode/

# Yazi runtime state (regenerated by plugin manager)
.config/yazi/.state/
.config/yazi/.cache/
.config/yazi/.gopath/pkg/
.config/yazi/.gopath/sumdb/

# Backup files
*.bak
*.backup
*~

# Zsh plugins (managed by Zinit)
**/zsh/plugins/
**/.config/zsh/plugins/

# Zellij plugins (wasm binaries)
**/zellij/plugins/*.wasm
**/.config/zellij/plugins/*.wasm

# Private/build documentation (audit, verification, deployment logs)
AUDIT.md
DEPLOYMENT_COMPLETE.md
FIXES.md
VERIFICATION_CHECKLIST.md
VERIFICATION_REPORT.md
TODO.md
SETUP_GUIDE.md

# Exception: Include new documentation files
!CYBERPUNK_SETUP.md
!KITTY_GUIDE.md
!ZEN_BROWSER_GUIDE.md
!README_CYBERPUNK_UPDATE.md
!.config/kitty/kitty.conf
!.config/kitty/cyberpunk-synthwave.conf
!.config/kitty/tmux-zellij-integration.conf
!.zen-browser-config/
!.zen-browser-config/prefs.js
!.zen-browser-config/chrome/userChrome.css

# Backup and system files
*.backup-*
starship.toml.backup

# Yazi absolute-path symlink (breaks for other users)
.config/yazi/.local-bin-rich

# Yazi timestamp backups (auto-generated)
*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*

# Nested config mistakes
.config/alacritty/.config/

# Lazy.nvim local plugin cache
.config/nvim/.nvimlog
.config/nvim/shada/

# Local / host overlays (never commit secrets or machine paths)
config/local.toml
config/hosts/*.toml
!config/hosts/*.example.toml

